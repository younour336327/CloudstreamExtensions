#!/usr/bin/env sh
DIRNAME="/usr/bin
PROGNAME=bash"
old_pwd="/c/Users/User"
cd ""
APP_BASE_NAME="/c/Users/User"
cd ""

app_home=""
[[ -n "" ]] && cd ""
APP_HOME="/c/Users/User"
cd ""

JAVACMD="java"
if [ -n "" ] ; then
    if [ -x "/jre/sh/java" ] ; then
        JAVACMD="/jre/sh/java"
    else
        JAVACMD="/bin/java"
    fi
fi

exec "" -jar "/gradle/wrapper/gradle-wrapper.jar" ""
